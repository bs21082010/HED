# Database
# Local dev (SQLite, no setup needed):
DATABASE_URL=sqlite:///./dorm.db
# Production (PostgreSQL via docker-compose):
# DATABASE_URL=postgresql+psycopg2://dorm:dorm@db:5432/dorm

# SMS provider: mock | twilio
SMS_PROVIDER=mock

# Twilio (only needed when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15005550006

# Comma-separated roles that receive red-alert SMS
SMS_NOTIFY_ROLES=supervisor,drill_instructor,admin

# CORS
CORS_ORIGINS=http://localhost:3000
